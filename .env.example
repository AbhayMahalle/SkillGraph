# SkillGraph Environment Configuration Example
# Copy this file to .env and configure for your environment.

# Application Environment Mode: 'development' or 'production'
ENVIRONMENT=development

# JWT Secret Key for Session Authentication
# In production, generate a secure 64-character random string (e.g., using `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-secure-random-secret-key-for-production

# Allowed CORS Origins (comma-separated list)
# Default development origins: http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection URL (Defaults to SQLite at data/processed/skillgraph.db)
# DATABASE_URL=sqlite:///data/processed/skillgraph.db

# Server Bind Configuration
HOST=127.0.0.1
PORT=8000
